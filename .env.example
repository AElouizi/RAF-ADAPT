# Projet Supabase : Analyste_IA_26 (Bourse de Casablanca)
# Project ref : pungyebagtntbocoewir
# Dashboard → Project Settings → API
# https://supabase.com/dashboard/project/<project-ref>/settings/api

# Variables principales (les scripts acceptent aussi NEXT_PUBLIC_* du front Next.js)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=your-anon-or-publishable-key-here

# Alias acceptés : SUPABASE_ANON_KEY, NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY

# Clé service_role — bypass RLS, imports batch uniquement. NE JAMAIS committer.
# Dashboard → Project Settings → API → Project API keys → service_role (secret)
# https://supabase.com/dashboard/project/<project-ref>/settings/api
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9....

# Vérification TLS (true par défaut). Mettre false UNIQUEMENT derrière un proxy d'entreprise.
# SUPABASE_VERIFY_SSL=false

# MASI depuis 2010 : si l'API anon ne voit que ~741 lignes (depuis 2022) alors que le
# SQL Editor montre l'historique complet, ajouter l'une de ces variables :
# SUPABASE_SERVICE_ROLE_KEY=...   (Dashboard → API → service_role, secret)
# DATABASE_URL=postgresql://postgres.[ref]:[password]@...pooler.supabase.com:6543/postgres

# Noms de tables (optionnel — valeurs par défaut ci-dessous)
# TABLE_FONDAMENTAUX_RS=fondamentaux_rs
# TABLE_DONNEES_FINANCIERS=donnees_financieres
# TABLE_COURS_HISTORIQUE=market_data_cours_historique
# TABLE_INDICES_HISTORIQUE=market_data_indices_historique

# Périmètre historique des cours (défaut : 2010-01-01)
# COURS_MIN_DATE=2010-01-01
